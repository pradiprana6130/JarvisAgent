<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="5dp">

    <!-- USER MESSAGE CONTAINER (Aligned End with 'You' Avatar on right) -->
    <LinearLayout
        android:id="@+id/layoutUserContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:gravity="top|end"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- User Message Bubble -->
        <LinearLayout
            android:id="@+id/layoutUserBubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="280dp"
            android:background="@drawable/bg_user_bubble"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <!-- Attachment File Pill -->
            <LinearLayout
                android:id="@+id/layoutUserAttachment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_card_inner"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                android:paddingVertical="6dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/ivUserAttachmentIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_description"
                    app:tint="@color/primary_cyan" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvUserAttachmentName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp"
                        tools:text="JARVIS_Setup_Guide.md" />

                    <TextView
                        android:id="@+id/tvUserAttachmentSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:textColor="#7B96A8"
                        android:textSize="10.5sp"
                        tools:text="18.6 KB • 142 lines" />
                </LinearLayout>
            </LinearLayout>

            <!-- User Image Preview -->
            <ImageView
                android:id="@+id/ivUserImagePreview"
                android:layout_width="200dp"
                android:layout_height="140dp"
                android:layout_marginBottom="6dp"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- User Text -->
            <TextView
                android:id="@+id/tvUserText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="3dp"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                tools:text="Check this .md file and explain the content" />

            <!-- Timestamp & Double Checkmarks -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvUserTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="#7B96A8"
                    android:textSize="9.5sp"
                    tools:text="12:43 AM" />

                <ImageView
                    android:id="@+id/ivUserCheckmark"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_done_all"
                    app:tint="@color/primary_cyan" />
            </LinearLayout>
        </LinearLayout>

        <!-- 'You' Avatar Column -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_drawer_logo_ring">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_person"
                    app:tint="@color/primary_cyan" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="You"
                android:textColor="#7B96A8"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- JARVIS MESSAGE CONTAINER (Aligned Start with Arc-Reactor Avatar on left) -->
    <LinearLayout
        android:id="@+id/layoutJarvisContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginTop="8dp"
        android:gravity="top|start"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Glowing JARVIS Arc Reactor Avatar -->
        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_drawer_logo_ring">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/logo_jarvis"
                android:contentDescription="JARVIS" />
        </FrameLayout>

        <!-- JARVIS Bubble -->
        <LinearLayout
            android:id="@+id/layoutJarvisBubble"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_jarvis_bubble"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <!-- Sender Header: JARVIS  12:43 AM  [Copy] -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.08"
                    android:text="JARVIS"
                    android:textColor="@color/primary_cyan"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvJarvisTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:textColor="#7B96A8"
                    android:textSize="9.5sp"
                    tools:text="12:43 AM" />

                <ImageButton
                    android:id="@+id/btnCopyJarvisResponse"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Copy response"
                    android:padding="3dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_content_copy"
                    app:tint="@color/primary_cyan" />
            </LinearLayout>

            <!-- Text Content -->
            <TextView
                android:id="@+id/tvJarvisText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="3dp"
                android:textColor="#E0F7FA"
                android:textSize="13.5sp"
                tools:text="Got it, Pradip.\nI've received the .md file successfully.\nLet me read and analyze the content..." />

            <!-- 1. ATTACHMENT PROGRESS CARD (Analyzing document... 100%) -->
            <LinearLayout
                android:id="@+id/layoutProgressCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_inner"
                android:orientation="vertical"
                android:padding="10dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivProgressIcon"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_description"
                        app:tint="@color/primary_cyan" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvProgressFileName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="#FFFFFF"
                            android:textSize="12.5sp"
                            tools:text="JARVIS_Setup_Guide.md" />

                        <TextView
                            android:id="@+id/tvProgressFileMeta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:textColor="#7B96A8"
                            android:textSize="10.5sp"
                            tools:text="18.6 KB • 142 lines" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivProgressCheck"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_check"
                        app:tint="@color/status_green" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressBarDocument"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="100"
                    android:progressTint="@color/primary_cyan" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvProgressStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif"
                        android:text="Analyzing document..."
                        android:textColor="@color/primary_cyan"
                        android:textSize="10.5sp" />

                    <TextView
                        android:id="@+id/tvProgressPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="100%"
                        android:textColor="@color/primary_cyan"
                        android:textSize="10.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. WEATHER CARD (Current Location Weather) -->
            <LinearLayout
                android:id="@+id/layoutWeatherCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_inner"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Cloud / Weather Icon & Temperature -->
                    <ImageView
                        android:id="@+id/ivWeatherCondition"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_wb_sunny"
                        app:tint="#FFFFFF" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvWeatherTemp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="28°C"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvWeatherConditionText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="Clear"
                            android:textColor="#7B96A8"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <!-- Details: Location, Feels like, Humidity, Wind -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvWeatherLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="📍 New Delhi, IN"
                            android:textColor="@color/primary_cyan"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvWeatherFeelsLike"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif"
                            android:text="🌡 Feels like 30°C"
                            android:textColor="#8AA2B2"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/tvWeatherHumidity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif"
                            android:text="💧 Humidity 54%"
                            android:textColor="#8AA2B2"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/tvWeatherWind"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif"
                            android:text="💨 Wind 12 km/h"
                            android:textColor="#8AA2B2"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvWeatherBottomNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif"
                    android:text="The weather is clear with a comfortable temperature. Let me know if you need a detailed forecast."
                    android:textColor="#B0C4D0"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 3. FIVE DAY FORECAST CARD -->
            <LinearLayout
                android:id="@+id/layoutForecastCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_inner"
                android:orientation="vertical"
                android:padding="10dp"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- 5 Columns for Mon, Tue, Wed, Thu, Fri -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="5">

                    <!-- Day 1 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_hud_bracket_frame"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mon" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5 Oct" android:textColor="#7B96A8" android:textSize="8.5sp" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginVertical="3dp" android:src="@drawable/ic_wb_sunny" app:tint="#FFA000" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="28°/22°" android:textColor="#FFFFFF" android:textSize="9.5sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Clear" android:textColor="#7B96A8" android:textSize="8sp" />
                    </LinearLayout>

                    <!-- Day 2 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_hud_bracket_frame"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tue" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6 Oct" android:textColor="#7B96A8" android:textSize="8.5sp" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginVertical="3dp" android:src="@drawable/ic_wb_sunny" app:tint="#00F2FE" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="30°/23°" android:textColor="#FFFFFF" android:textSize="9.5sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pt Cloudy" android:textColor="#7B96A8" android:textSize="8sp" />
                    </LinearLayout>

                    <!-- Day 3 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_hud_bracket_frame"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wed" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="7 Oct" android:textColor="#7B96A8" android:textSize="8.5sp" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginVertical="3dp" android:src="@drawable/ic_wb_sunny" app:tint="#FFA000" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="31°/24°" android:textColor="#FFFFFF" android:textSize="9.5sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sunny" android:textColor="#7B96A8" android:textSize="8sp" />
                    </LinearLayout>

                    <!-- Day 4 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_hud_bracket_frame"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thu" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="8 Oct" android:textColor="#7B96A8" android:textSize="8.5sp" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginVertical="3dp" android:src="@drawable/ic_wb_sunny" app:tint="#00F2FE" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="29°/23°" android:textColor="#FFFFFF" android:textSize="9.5sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rain" android:textColor="#7B96A8" android:textSize="8sp" />
                    </LinearLayout>

                    <!-- Day 5 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_hud_bracket_frame"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fri" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="9 Oct" android:textColor="#7B96A8" android:textSize="8.5sp" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginVertical="3dp" android:src="@drawable/ic_wb_sunny" app:tint="#B0BEC5" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="27°/22°" android:textColor="#FFFFFF" android:textSize="9.5sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cloudy" android:textColor="#7B96A8" android:textSize="8sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Lightbulb Tip -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_hud_bracket_frame"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_lightbulb"
                        app:tint="#FFD600" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif"
                        android:text="Overall, the weather will remain pleasant this week with a chance of light rain on Thursday."
                        android:textColor="#E0F7FA"
                        android:textSize="10.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 4. DOCUMENT / PDF SUMMARY CARD -->
            <LinearLayout
                android:id="@+id/layoutSummaryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_inner"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Header: Icon + Title + Badge + 3-Dots -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivSummaryDocIcon"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_description"
                        app:tint="@color/primary_cyan" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSummaryTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="JARVIS Setup Guide" />

                        <TextView
                            android:id="@+id/tvSummaryDocSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:textColor="#7B96A8"
                            android:textSize="10.5sp"
                            tools:text="Project Documentation" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSummaryTypeBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_filter_chip_inactive"
                        android:fontFamily="sans-serif-bold"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text=".MD"
                        android:textColor="@color/primary_cyan"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <!-- Overview Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Overview"
                    android:textColor="@color/primary_cyan"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/tvSummaryOverview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="2dp"
                    android:textColor="#CFD8DC"
                    android:textSize="11sp"
                    tools:text="This file contains a complete guide to set up and run the JARVIS AI application, including requirements, installation steps, configuration details, and usage instructions." />

                <!-- Key Sections / Points -->
                <TextView
                    android:id="@+id/tvSummaryKeySectionHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Key Sections"
                    android:textColor="@color/primary_cyan"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/tvSummaryKeySections"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="3dp"
                    android:textColor="#90A4AE"
                    android:textSize="10.5sp"
                    tools:text="• 1. Introduction (12 lines)\n• 2. System Requirements (18 lines)\n• 3. Installation Steps (36 lines)\n• 4. Configuration (28 lines)\n• 5. Usage Guide (22 lines)" />

                <!-- Action Buttons: [Show Full Content] [Detailed Summary] [Suggest Edits] -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_filter_chip_inactive"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="Show Full Content"
                        android:textColor="@color/primary_cyan"
                        android:textSize="9.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_filter_chip_inactive"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="Detailed Summary"
                        android:textColor="@color/primary_cyan"
                        android:textSize="9.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_filter_chip_inactive"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="Suggest Edits"
                        android:textColor="@color/primary_cyan"
                        android:textSize="9.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 5. IMAGE ANALYSIS CARD -->
            <LinearLayout
                android:id="@+id/layoutImageAnalysisCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_inner"
                android:orientation="vertical"
                android:padding="10dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivAnalyzedImageThumbnail"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:background="@drawable/bg_drawer_logo_ring"
                        android:padding="3dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/logo_jarvis" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="Image Received"
                            android:textColor="#FFFFFF"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvImageAnalysisFileName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="sans-serif"
                            android:textColor="#7B96A8"
                            android:textSize="10.5sp"
                            tools:text="image.jpg" />

                        <TextView
                            android:id="@+id/tvImageAnalysisMeta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="sans-serif"
                            android:textColor="#7B96A8"
                            android:textSize="10.5sp"
                            tools:text="1.2 MB • 2048 x 2048" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_check"
                        app:tint="@color/status_green" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif"
                    android:text="You can now ask me anything about this image — describe, analyze, extract text, or make changes."
                    android:textColor="#B0C4D0"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
