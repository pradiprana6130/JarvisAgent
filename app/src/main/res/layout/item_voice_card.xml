<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_voice_card_unselected"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Custom Radio Button Indicator -->
    <ImageView
        android:id="@+id/ivRadioIndicator"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="center_vertical"
        android:contentDescription="Selection Indicator"
        android:src="@drawable/bg_voice_radio_unselected" />

    <!-- Voice Name, Style Tags & Descriptive Overview -->
    <LinearLayout
        android:id="@+id/layoutTextInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvVoiceName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Fenrir" />

        <TextView
            android:id="@+id/tvVoiceTags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            tools:text="Deep • Confident • Protective" />

        <TextView
            android:id="@+id/tvVoiceDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="2dp"
            android:textColor="#82A0AF"
            android:textSize="12sp"
            tools:text="A deep, mature and confident voice. Great for serious conversations, guidance and a reliable assistant feel." />
    </LinearLayout>

    <!-- Circular Test/Preview Button -->
    <FrameLayout
        android:id="@+id/btnPreviewVoice"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/bg_voice_preview_btn"
        android:clickable="true"
        android:contentDescription="Preview Voice"
        android:focusable="true">

        <ImageView
            android:id="@+id/ivPlayIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="Play"
            android:src="@drawable/ic_play_arrow"
            app:tint="#00E5FF" />

        <ProgressBar
            android:id="@+id/progressBarLoading"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:indeterminateTint="#00E5FF"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ivStopIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:contentDescription="Stop"
            android:src="@drawable/ic_stop"
            android:visibility="gone"
            app:tint="#00E5FF" />
    </FrameLayout>

</LinearLayout>
